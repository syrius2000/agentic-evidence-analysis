{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3way-foundation-v1"
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "vars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "freq": {
      "type": "string",
      "minLength": 1
    },
    "response_var": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "total_n_meaning": {
          "type": "string",
          "minLength": 1
        },
        "independence_assumption": {
          "enum": [
            "assumed_independent",
            "unverified",
            "dependent_blocked"
          ]
        },
        "is_scaled": {
          "type": "boolean"
        },
        "scaling_factor": {
          "type": "number",
          "minimum": 1
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "unit",
        "total_n_meaning",
        "independence_assumption",
        "is_scaled"
      ]
    },
    "levels": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "uniqueItems": true
      }
    },
    "missing_policy": {
      "enum": [
        "reject",
        "hold"
      ]
    },
    "absent_cell_policy": {
      "enum": [
        "reject",
        "hold",
        "sample_zero"
      ]
    },
    "structural_zeros": {
      "type": "array"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "==",
              "in"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "required": [
          "column",
          "op",
          "values"
        ]
      }
    },
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_alpha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sensitivity": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "draws": {
          "type": "integer",
          "minimum": 20000,
          "maximum": 100000
        }
      },
      "required": [
        "total_alpha"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "consultation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspection": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "inspection",
        "input_sha256",
        "rationale"
      ]
    }
  },
  "required": [
    "schema_version",
    "input",
    "vars",
    "freq",
    "output_dir",
    "run_id",
    "sampling",
    "levels",
    "missing_policy",
    "absent_cell_policy",
    "consultation"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "3元表の設定。入力ハッシュ、水準対応、度数、標本前提はR入口で追加検証する。"
}