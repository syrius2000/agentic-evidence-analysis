{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vcd-bayesian-evidence-analysis/analysis_config.schema.json",
  "title": "vcd-bayesian-evidence-analysis analysis_config.json",
  "description": "Pass 0 produces this flat JSON config for Pass 1 analysis.R.",
  "type": "object",
  "required": ["input", "vars", "freq", "output_dir", "run_id", "pass0_provenance"],
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "description": "UTF-8 CSV input path."
    },
    "vars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Categorical variable columns to analyze."
    },
    "freq": {
      "type": "string",
      "minLength": 1,
      "description": "Frequency/count column."
    },
    "response_var": {
      "type": "string",
      "minLength": 1,
      "description": "Optional response/outcome variable. For 3+ dimensions, Cramer's V is computed on predictor-level combinations by response_var."
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Pass 1 output root. analysis.R writes run_<prefix>/ below this directory."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Run identifier before run_<first 16 chars> output isolation."
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "base_model": {
      "type": "string",
      "default": "M1",
      "description": "Base Poisson log-linear model for 4-axis cell diagnostics (e.g., M1 to M8)."
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "default": 10,
      "description": "Number of top cells to report by effect size."
    },
    "large_n_threshold": {
      "type": "integer",
      "minimum": 1,
      "default": 2000,
      "description": "Sample size threshold to activate Dual-Filter mode."
    },
    "pass0_provenance": {
      "type": "object",
      "required": ["contract_version", "inspection_results", "inspection_results_sha256", "input_sha256", "finalized_at_jst", "target_skill"],
      "properties": {
        "contract_version": { "type": "string", "const": "1.0" },
        "inspection_results": { "type": "string", "minLength": 1 },
        "inspection_results_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "finalized_at_jst": { "type": "string", "minLength": 1 },
        "target_skill": { "type": "string", "minLength": 1 },
        "scope_document": { "type": "string", "minLength": 1 },
        "scope_document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
