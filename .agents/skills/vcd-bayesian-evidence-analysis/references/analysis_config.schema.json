{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vcd-bayesian-evidence-analysis/analysis_config.schema.json",
  "title": "vcd-bayesian-evidence-analysis analysis_config.json",
  "description": "Pass 0 produces this flat JSON config for Pass 1 analysis.R.",
  "type": "object",
  "required": ["input", "vars", "freq", "output_dir", "run_id"],
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "description": "UTF-8 CSV input path."
    },
    "vars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Categorical variable columns to analyze."
    },
    "freq": {
      "type": "string",
      "minLength": 1,
      "description": "Frequency/count column."
    },
    "response_var": {
      "type": "string",
      "minLength": 1,
      "description": "Optional response/outcome variable. For 3+ dimensions, Cramer's V is computed on predictor-level combinations by response_var."
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Pass 1 output root. analysis.R writes run_<prefix>/ below this directory."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Run identifier before run_<first 16 chars> output isolation."
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1
    },
    "threshold_k": {
      "type": "number"
    },
    "large_n_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "ebic_gamma": {
      "type": "number"
    },
    "ebic_p": {
      "type": "number"
    },
    "level2_factor": {
      "type": "number"
    },
    "level3_factor": {
      "type": "number"
    },
    "arm_top_rules": {
      "type": "integer",
      "minimum": 1
    },
    "arm_min_support": {
      "type": "number"
    },
    "base_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9"]
      },
      "description": "Base Poisson log-linear models for multi-baseline 4-axis cell diagnostics (e.g. ['M1', 'M5'])."
    },
    "base_model": {
      "type": "string",
      "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9"],
      "description": "Legacy single base model specifier (normalized into base_models)."
    },
    "conditional_rate_view": {
      "type": "object",
      "required": ["response_var", "numerator_levels", "denominator_levels", "compare_by", "stratify_by"],
      "properties": {
        "response_var": {
          "type": "string",
          "minLength": 1,
          "description": "Response/outcome variable column name."
        },
        "numerator_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "One or more target response levels to include in the numerator."
        },
        "denominator_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "One or more response levels defining the denominator (superset of numerator_levels)."
        },
        "compare_by": {
          "type": "string",
          "minLength": 1,
          "description": "Variable column name defining comparison groups (e.g. Gender)."
        },
        "stratify_by": {
          "type": "string",
          "minLength": 1,
          "description": "Variable column name defining stratification slices (e.g. Dept)."
        },
        "interval_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.95,
          "description": "Credible interval coverage level (e.g. 0.95 for 95% ETI)."
        },
        "reference_level": {
          "type": "string",
          "minLength": 1,
          "description": "Optional reference level of compare_by variable for rate difference calculations."
        }
      },
      "additionalProperties": false,
      "description": "Specification for generic conditional Bayesian rate and difference inference."
    },
    "arm_min_confidence": {
      "type": "number"
    },
    "dirichlet_prior": {
      "type": "object",
      "description": "Symmetric Dirichlet hyperparameters for 3-way conditional rates. interval_level lives under conditional_rate_view, not here.",
      "properties": {
        "primary_alpha": {
          "type": "number",
          "const": 0.5,
          "default": 0.5,
          "description": "Primary symmetric Dirichlet cell alpha (Jeffreys = 0.5)."
        },
        "sensitivity_alpha": {
          "type": "number",
          "const": 1.0,
          "default": 1.0,
          "description": "Sensitivity symmetric Dirichlet cell alpha (uniform-on-simplex = 1.0)."
        }
      },
      "additionalProperties": false
    },
    "factor_levels_order": {
      "type": "object",
      "description": "Explicit factor level ordering per variable for deterministic canonical cell ordering.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "conditional_rank_reproducibility": {
      "type": "object",
      "description": "Configuration for evaluating conditional rank reproducibility via multinomial resampling.",
      "required": ["enabled", "target_baseline_model", "target_metric", "top_k", "iterations", "seed"],
      "properties": {
        "enabled": { "type": "boolean" },
        "target_baseline_model": {
          "type": "string",
          "enum": ["M1", "M5"]
        },
        "target_metric": {
          "type": "string",
          "enum": ["abs_log_oe"]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 2
        },
        "seed": {
          "type": "integer"
        },
        "quality_gate_minimum_valid_rate": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "default": 0.95,
          "description": "Minimum proportion of valid iterations required to accept CRR results without HOLD."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
