{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrozenReferenceRangeV1",
  "description": "Versioned frozen feature ranges for Gower distance in evidence-decision-review (Section 13.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "range_version",
    "feature_schema_version",
    "features"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "frozen-reference-range-v1" },
    "range_version": { "type": "string", "minLength": 1 },
    "feature_schema_version": { "type": "string", "minLength": 1 },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "min", "max"],
            "properties": {
              "type": { "const": "numeric" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "levels"],
            "properties": {
              "type": { "const": "categorical" },
              "levels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": ["string", "boolean"] }
              }
            }
          }
        ]
      }
    }
  }
}
