{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoricalPrecedentCaseV1",
  "description": "Historical precedent case for evidence-decision-review (Section 13.7–13.8). Decision labels live only in decision_context; evidence_feature remains decision-label-free.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "versions",
    "evidence_feature",
    "decision_context"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "historical-precedent-case-v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dictionary_release_version",
        "delta_policy_version",
        "feature_schema_version"
      ],
      "properties": {
        "dictionary_release_version": { "type": "string", "minLength": 1 },
        "delta_policy_version": { "type": "string", "minLength": 1 },
        "feature_schema_version": { "type": "string", "minLength": 1 },
        "range_version": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_feature": {
      "$ref": "evidence-feature-v1.json"
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_state",
        "reviewer_justification_md",
        "actor_id",
        "decided_at_jst"
      ],
      "properties": {
        "decision_state": { "type": "string", "minLength": 1 },
        "reviewer_justification_md": { "type": "string" },
        "actor_id": { "type": "string", "minLength": 1 },
        "decided_at_jst": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
