{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionTrajectoryV1",
  "description": "Longitudinal decision trajectory across study phases or data cutoffs (Section 13.12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "n_events",
    "n_changes",
    "trajectory",
    "events",
    "exploratory_only",
    "decision_rule",
    "wording"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "decision-trajectory-v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "n_events": { "type": "integer", "minimum": 1 },
    "n_changes": { "type": "integer", "minimum": 0 },
    "trajectory": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "study_phases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "data_cutoffs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "decision_state", "decided_at_jst"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "decision_state": { "type": "string", "minLength": 1 },
          "decided_at_jst": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} JST$"
          },
          "study_phase": { "type": ["string", "null"], "minLength": 1 },
          "data_cutoff": { "type": ["string", "null"], "minLength": 1 },
          "record_id": { "type": ["string", "null"], "minLength": 1 },
          "actor_id": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "exploratory_only": { "type": "boolean", "const": true },
    "decision_rule": { "type": "boolean", "const": false },
    "wording": { "type": "string", "minLength": 1 }
  }
}
