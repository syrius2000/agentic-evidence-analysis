{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pass0RoutingDecisionV1",
  "description": "Canonical Pass 0 routing artifact for comparative-evidence-reporting-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_file",
    "input_sha256",
    "config_sha256",
    "target_engine_slug",
    "engine_module",
    "inferential_semantics",
    "design",
    "estimand",
    "practical_difference_mode",
    "diagnostics",
    "decision_review_required",
    "routing_timestamp"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "pass0-routing-v1" },
    "input_file": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "minLength": 1 },
    "config_sha256": { "type": "string", "minLength": 1 },
    "target_engine_slug": { "type": "string", "minLength": 1 },
    "engine_module": { "type": "string", "minLength": 1 },
    "inferential_semantics": {
      "type": "string",
      "enum": ["posterior", "bootstrap"]
    },
    "design": {
      "type": "string",
      "enum": ["independent_binary", "matched_pair", "matched_set", "iptw", "person_time"]
    },
    "estimand": { "type": "string", "minLength": 1 },
    "practical_difference_mode": {
      "type": "string",
      "enum": ["none", "fixed_delta"]
    },
    "primary_delta": { "type": ["number", "null"] },
    "diagnostics": { "type": "object" },
    "decision_review_required": { "type": "boolean" },
    "routing_timestamp": { "type": "string", "minLength": 1 },
    "subject_level_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reference"],
      "properties": {
        "target": { "$ref": "#/definitions/arm_counts" },
        "reference": { "$ref": "#/definitions/arm_counts" }
      }
    },
    "engine_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "target_events",
        "target_total",
        "reference_events",
        "reference_total",
        "source"
      ],
      "properties": {
        "contract": { "type": "string", "const": "independent_binary_counts_v1" },
        "target_events": { "type": "integer", "minimum": 0 },
        "target_total": { "type": "integer", "exclusiveMinimum": 0 },
        "reference_events": { "type": "integer", "minimum": 0 },
        "reference_total": { "type": "integer", "exclusiveMinimum": 0 },
        "source": {
          "type": "string",
          "enum": ["repeated_rows_any_event_collapse"]
        }
      }
    }
  },
  "definitions": {
    "arm_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "total"],
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "exclusiveMinimum": 0 }
      }
    }
  },
  "if": {
    "properties": {
      "diagnostics": {
        "type": "object",
        "required": ["repeated_rows"]
      }
    },
    "required": ["diagnostics"]
  },
  "then": {
    "required": ["subject_level_counts", "engine_input"],
    "properties": {
      "diagnostics": {
        "type": "object",
        "required": ["repeated_rows"],
        "properties": {
          "repeated_rows": {
            "type": "object",
            "required": [
              "assessed",
              "collapsible",
              "event_rule",
              "subject_id_col",
              "group_col",
              "outcome_col",
              "confirmed",
              "original_rows",
              "subject_count",
              "repeated_rows"
            ],
            "properties": {
              "assessed": { "type": "boolean", "const": true },
              "collapsible": { "type": "boolean", "const": true },
              "event_rule": { "type": "string", "const": "any_event" },
              "subject_id_col": { "type": "string", "minLength": 1 },
              "group_col": { "type": "string", "minLength": 1 },
              "outcome_col": { "type": "string", "minLength": 1 },
              "confirmed": { "type": "boolean", "const": true },
              "original_rows": { "type": "integer", "exclusiveMinimum": 0 },
              "subject_count": { "type": "integer", "exclusiveMinimum": 0 },
              "repeated_rows": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
