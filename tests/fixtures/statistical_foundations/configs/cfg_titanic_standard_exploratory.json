{
  "schema_version": "3way-foundation-v1",
  "input": "tests/fixtures/statistical_foundations/titanic_aggregated_3way.csv",
  "vars": ["Class", "Sex", "Survived"],
  "freq": "Freq",
  "response_var": {},
