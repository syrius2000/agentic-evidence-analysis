{
  "manifest_version": "1.0.0-pre-execution",
  "created_at": "2026-09-06T17:46:00+09:00",
  "description": "3次元カテゴリカル統計基盤検証のための検証ケース・候補モデル・参照計算・許容誤差定義",
  "models": [
    {
      "id": "M1",
      "name": "mutual_independence",
      "formula": "~ A + B + C",
      "description": "相互独立モデル（3変数すべてが互いに独立）",
      "margins": [["A"], ["B"], ["C"]],
      "max_interaction_order": 1
    },
    {
      "id": "M2",
      "name": "assoc_AB",
      "formula": "~ A*B + C",
      "description": "AとBの関連のみを許容し、Cは独立",
      "margins": [["A", "B"], ["C"]],
      "max_interaction_order": 2
    },
    {
      "id": "M3",
      "name": "assoc_AC",
      "formula": "~ A*C + B",
      "description": "AとCの関連のみを許容し、Bは独立",
      "margins": [["A", "C"], ["B"]],
      "max_interaction_order": 2
    },
    {
      "id": "M4",
      "name": "assoc_BC",
      "formula": "~ B*C + A",
      "description": "BとCの関連のみを許容し、Aは独立",
      "margins": [["B", "C"], ["A"]],
      "max_interaction_order": 2
    },
    {
      "id": "M5",
      "name": "cond_indep_BC_given_A",
      "formula": "~ A*B + A*C",
      "description": "Aで条件付けたときBとCが条件付き独立",
      "margins": [["A", "B"], ["A", "C"]],
      "max_interaction_order": 2
    },
    {
      "id": "M6",
      "name": "cond_indep_AC_given_B",
      "formula": "~ A*B + B*C",
      "description": "Bで条件付けたときAとCが条件付き独立",
      "margins": [["A", "B"], ["B", "C"]],
      "max_interaction_order": 2
    },
    {
      "id": "M7",
      "name": "cond_indep_AB_given_C",
      "formula": "~ A*C + B*C",
      "description": "Cで条件付けたときAとBが条件付き独立",
      "margins": [["A", "C"], ["B", "C"]],
      "max_interaction_order": 2
    },
    {
      "id": "M8",
      "name": "homogeneous_association",
      "formula": "~ A*B + A*C + B*C",
      "description": "均一連関モデル（すべての2因子交互作用を含み、3次交互作用を含まない）",
      "margins": [["A", "B"], ["A", "C"], ["B", "C"]],
      "max_interaction_order": 2
    },
    {
      "id": "M9",
      "name": "saturated",
      "formula": "~ A*B*C",
      "description": "飽和モデル（3次交互作用まで含む完全適合モデル）",
      "margins": [["A", "B", "C"]],
      "max_interaction_order": 3
    }
  ],
  "titanic_cases": {
    "source_file": "examples/titanic.csv",
    "variables": ["Class", "Sex", "Survived"],
    "ignored_and_aggregated_variable": "Age",
    "expected_cell_count": 16,
    "multipliers": [
      {
        "id": "standard",
        "factor": 1,
        "expected_total_n": 2201
      },
      {
        "id": "scaled_100x",
        "factor": 100,
        "expected_total_n": 220100
      }
    ],
    "search_modes": [
      {
        "id": "exploratory",
        "response_var": null,
        "description": "3変数を対等に扱う探索的モデル比較"
      },
      {
        "id": "directed",
        "response_var": "Survived",
        "description": "Survivedを目的変数とした条件付き確率・オッズ比視点の比較"
      }
    ]
  },
  "synthetic_tables": [
    {
      "id": "syn_independent",
      "name": "完全に独立な2x2x2人工表",
      "dimensions": ["A", "B", "C"],
      "levels": {
        "A": ["A1", "A2"],
        "B": ["B1", "B2"],
        "C": ["C1", "C2"]
      },
      "generation_formula": "n_ijk = N * p_A(i) * p_B(j) * p_C(k)",
      "target_n": 800,
      "p_A": [0.4, 0.6],
      "p_B": [0.3, 0.7],
      "p_C": [0.5, 0.5]
    },
    {
      "id": "syn_ab_associated",
      "name": "AB間のみ関連がありCは独立な2x2x2人工表",
      "dimensions": ["A", "B", "C"],
      "levels": {
        "A": ["A1", "A2"],
        "B": ["B1", "B2"],
        "C": ["C1", "C2"]
      },
      "generation_formula": "n_ijk = N * p_AB(i, j) * p_C(k)",
      "target_n": 800,
      "p_AB": [
        [0.35, 0.05],
        [0.15, 0.45]
      ],
      "p_C": [0.5, 0.5]
    },
    {
      "id": "syn_interaction_shifted",
      "name": "Cの層によってAB関連が逆転する3次交互作用人工表",
      "dimensions": ["A", "B", "C"],
      "levels": {
        "A": ["A1", "A2"],
        "B": ["B1", "B2"],
        "C": ["C1", "C2"]
      },
      "generation_formula": "C=C1ではAB正相関、C=C2ではAB逆相関",
      "target_n": 800,
      "p_ABC": [
        [[0.20, 0.05], [0.05, 0.20]],
        [[0.05, 0.20], [0.20, 0.05]]
      ]
    }
  ],
  "simulation_and_mcmc": {
    "random_seed": 20260906,
    "posterior_draws": 20000,
    "dirichlet_priors": [
      {
        "id": "uniform_total_mass_1",
