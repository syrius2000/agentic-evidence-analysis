      "operational_context": "v4.1 OpenSpec実装の変更レビュー。入力境界、統計量、JSON成果物、Pass 0来歴、テストとE2E監査証跡を検証する。"
    },
    "risk_context": {
      "criticality": "high",
      "safety_impact": "誤った入力モード、来歴回避、統計計算不整合により誤った解析解釈が生成されるリスク",
      "data_integrity_impact": "度数の暗黙変換、欠損消失、入力・設定・成果物の署名不一致により監査再現性が失われるリスク",
      "security_context": "対象外"
    },
    "requirements": [
